
# ==========================================
# CareerPilot AI - GPT Researcher 环境配置
# PyCharm / Windows / DeepSeek
# ==========================================

# 1. DeepSeek 官方模型密钥
DEEPSEEK_API_KEY=在这里填写你的DeepSeek官方密钥

# 2. 模型配置
FAST_LLM=deepseek:deepseek-chat
SMART_LLM=deepseek:deepseek-chat
STRATEGIC_LLM=deepseek:deepseek-chat

# 3. 免费搜索引擎
RETRIEVER=duckduckgo

# 4. 使用本地关键词过滤，不调用向量模型
CONTEXT_FILTER=keyword

# 5. 研究报告语言
LANGUAGE=chinese

# 6. 文档目录
DOC_PATH=./my-docs

# 7. 首次运行控制研究规模
MAX_ITERATIONS=1
MAX_SEARCH_RESULTS_PER_QUERY=3
MAX_SCRAPER_WORKERS=3

# 8. 网页内容提取方式
SCRAPER=bs

# 9. LLM 最大输出 Token
FAST_TOKEN_LIMIT=3000
SMART_TOKEN_LIMIT=6000
STRATEGIC_TOKEN_LIMIT=4000
